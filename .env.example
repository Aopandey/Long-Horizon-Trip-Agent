# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Ollama server that serves the model (local machine or the school server).
OLLAMA_HOST=http://localhost:11434
TRIP_AGENT_MODEL=qwen3.5:9b

# Supabase project (Project Settings -> API). Use the secret / service-role key:
# it bypasses row-level security, so keep it on trusted machines only.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=
